# Copy to .env (never commit .env). Create Ollama key at https://ollama.com/settings/keys
# Replace empty values with real keys locally; never share or commit keys.
# Ollama Cloud chat + local bge-m3 embeddings (no embedding API key required).
# Install Ollama, run `ollama pull bge-m3`, keep localhost:11434 running.
EMBEDDING_PROVIDER=ollama_local
OLLAMA_LOCAL_EMBEDDING_MODEL=bge-m3
OLLAMA_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=gpt-oss:120b
# Set EMBEDDING_PROVIDER=openai, openrouter, or gemini to match your embedding key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a provider instead of the order above
# LLM_PROVIDER=openai          # ollama | openai | openrouter | gemini | anthropic
# EMBEDDING_PROVIDER=openai    # openai | openrouter | gemini

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
